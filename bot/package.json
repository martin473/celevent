{
  "name": "celevent-bot",
  "private": true,
  "version": "0.1.0",
  "description": "Finds Pittsburgh show announcements on Bluesky, has an LLM vet them, and reposts the real ones.",
  "type": "module",
  "engines": {
    "node": ">=22.9"
  },
  "bin": {
    "celevent-bot": "src/cli.js"
  },
  "scripts": {
    "migrate": "node --env-file-if-exists=.env src/cli.js migrate",
    "run-once": "node --env-file-if-exists=.env src/cli.js run",
    "loop": "node --env-file-if-exists=.env src/cli.js loop",
    "stream": "node --env-file-if-exists=.env src/cli.js stream",
    "login": "node --env-file-if-exists=.env src/cli.js login",
    "status": "node --env-file-if-exists=.env src/cli.js status",
    "discover": "node --env-file-if-exists=.env src/cli.js discover",
    "scrape": "node --env-file-if-exists=.env src/cli.js scrape",
    "directory": "node --env-file-if-exists=.env src/cli.js directory",
    "serve": "node --env-file-if-exists=.env src/cli.js serve",
    "start": "node src/cli.js serve",
    "publish-feed": "node --env-file-if-exists=.env src/cli.js publish-feed",
    "oauth-keygen": "node src/cli.js oauth-keygen",
    "test": "node --env-file-if-exists=.env --test test/*.test.js",
    "test:coverage": "node --env-file-if-exists=.env --test --experimental-test-coverage --test-coverage-exclude=\"test/**\" --test-coverage-lines=85 --test-reporter=spec --test-reporter-destination=stdout --test-reporter=lcov --test-reporter-destination=lcov.info --test-reporter=tap --test-reporter-destination=test.tap test/*.test.js"
  },
  "dependencies": {
    "@atproto/api": "^0.29.1",
    "@atproto/oauth-client-node": "^0.5.11",
    "pg": "^8.13.1"
  }
}
