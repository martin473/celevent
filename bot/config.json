    "min_confidence": 0.75,
    "window_days": 21,
    "max_attempts": 3
  },

  "repost": {
    "max_per_run": 10,
    "max_per_day": 40,
    "dry_run": true
  },

  "jetstream": {
    "endpoint": "wss://jetstream2.us-east.bsky.network/subscribe",
    "checkpoint_seconds": 10,
    "rewind_seconds": 5
  },

  "discover": {
    "aggregators": [
      "Pittsburgh City Paper",
      "91.3 WYEP",
      "NEXTpittsburgh",
      "WESA",
      "Pittsburgh Magazine"
