    "min_confidence": 0.7,
    "active_within_days": 30,
    "refresh_days": 30,
    "max_steps": 6,
    "concurrency": 4,
    "auto_follow": true
  },

  "scrape": {
    "enabled": true,
    "interval_hours": 12,
    "post_within_days": 10,
    "max_posts_per_run": 5,
