# Postgres (docker compose up -d gives you this one)
DATABASE_URL=postgres://celevent:celevent@localhost:5432/celevent

# LLM review: Ollama or Claude. Set one.
#   Ollama Cloud: key from ollama.com/settings/keys (uses https://ollama.com)
OLLAMA_API_KEY=
#   Local Ollama instead: leave the key empty and set
# OLLAMA_HOST=http://localhost:11434
#   Claude instead:
# ANTHROPIC_API_KEY=
# Model override (default gpt-oss:20b for Ollama, claude-haiku-5-5 for Claude)
# CELEVENT_MODEL=gpt-oss:120b

# Bluesky auth for the bot account. Pick one:
#   1) App password (simplest for a cron job)
BSKY_IDENTIFIER=pghshows.bsky.social
BSKY_APP_PASSWORD=
#   2) OAuth with DPoP: leave BSKY_APP_PASSWORD empty, set BSKY_AUTH=oauth,
#      and run `npm run login -- pghshows.bsky.social` once.
# BSKY_AUTH=oauth
# BSKY_OAUTH_PORT=8789
# BSKY_OAUTH_SCOPE=atproto transition:generic

# Ticketmaster Discovery API (free key at developer.ticketmaster.com): big-venue listings
# TICKETMASTER_API_KEY=

# ── Production (npm run serve / Fly.io) ───────────────────────────────
# Public HTTPS address of this bot; enables the custom feed and hosted OAuth.
# PUBLIC_URL=https://pgh-shows-bot.fly.dev
# Confidential OAuth client key: generate with `npm run oauth-keygen`.
# OAUTH_PRIVATE_KEY=
# Required to start OAuth sign-in at /oauth/login?token=...  (any long random string)
# ADMIN_TOKEN=
# Alerts: Discord or Slack webhook URL, or https://ntfy.sh/<your-topic> for phone push.
# ALERT_WEBHOOK_URL=
# Run the live Jetstream collector inside `serve` too.
# JETSTREAM=1

# Record decisions without reposting. Flip to 0 once the decisions look right.
DRY_RUN=1

# Tests: a Postgres where the test user can CREATE DATABASE
TEST_DATABASE_URL=postgres://celevent:celevent@localhost:5432/celevent
